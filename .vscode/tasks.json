{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "cmake",
      "command": "configure",
      "preset": "msvc-x64",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "cmake",
      "command": "build",
      "preset": "debug",
      "dependsOn": "CMake: Configure",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CMake: Test Debug",
      "type": "cmake",
      "command": "test",
      "preset": "test-debug",
      "dependsOn": "CMake: Build",
      "problemMatcher": []
    },
    {
      "label": "Workflow: Fast Verify",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/verify.ps1",
        "-Profile",
        "Fast"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Workflow: Full Verify",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/verify.ps1",
        "-Profile",
        "Full"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
