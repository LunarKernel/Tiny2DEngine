root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cc,h}]
indent_style = space
indent_size = 2

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
